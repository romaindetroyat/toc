{
  // TOC en ligne : Worker avec ressources statiques (pas Pages).
  // Construire d'abord : pnpm --filter @toc/web build
  // Le Worker (apps/worker) répond à /api/* et /ws/* ; le reste est l'application construite.
  // Les blocs durable_objects, migrations et d1_databases sont identiques dans wrangler.embarque.jsonc
  // (tools/wrangler-configs.test.ts le vérifie).
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "toc",
  "main": "./apps/worker/src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  // Les clés d'accès (passkeys) : l'identifiant du site (RP ID) et son origine, identiques dans les deux
  // fichiers (D-10). Les secrets (TOC_PEPPER, TOC_BOOTSTRAP) ne sont jamais ici : wrangler secret put.
  "vars": { "RP_ID": "toc.romaindetroyat.workers.dev", "ORIGIN": "https://toc.romaindetroyat.workers.dev" },
  "durable_objects": {
    "bindings": [{ "name": "GAME_ROOM", "class_name": "GameRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  "d1_databases": [
    { "binding": "DB", "database_name": "toc", "database_id": "a5700309-470a-469c-a76a-d3e0c5774335", "migrations_dir": "apps/worker/migrations" }
  ]
}
